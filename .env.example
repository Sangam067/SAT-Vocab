# ==========================================
# SAT Vocab Environment Configuration
# ==========================================

# Port (Optional, default 3001 locally, Render assigns automatically)
PORT=3001

# Turso Cloud Database (Leave empty for local SQLite, set in Render for persistent cloud DB)
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
